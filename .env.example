# Copy to .env and fill in. See src/agentic_trading/config.py for all fields/defaults.

# --- Trading mode ---
#   DRY_RUN       - real market data + real LLM decisions, but a fully simulated
#                   in-memory broker (fake fills, no network, no MCP/OAuth
#                   needed) -- the default, for local/dev testing at any time.
#   PAPER_TRADING - the same simulated broker/order lifecycle as DRY_RUN, meant
#                   to be run during real market hours as the final, capital-
#                   free rehearsal of what LIVE would do before promoting to it.
#                   Trades are tagged PAPER_TRADING in the DB, distinct from
#                   DRY_RUN, so paper-trading performance can be reviewed apart
#                   from ad hoc dev runs.
#   LIVE          - real orders via the Robinhood MCP, real money.
MODE=DRY_RUN

# --- Database: Supabase Postgres connection string (Session Pooler recommended) ---
# Using plain SQLAlchemy+asyncpg, not the supabase-py SDK, so this is swappable to any
# Postgres-compatible host later by changing only this value.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres

# --- LLM: local Ollama running gemma by default. Swap LLM_PROVIDER/LLM_MODEL to change. ---
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.0
# To use Ollama Cloud instead of a local daemon, set both of these (leave unset for local):
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=<your Ollama Cloud API key>
# LLM_MODEL=gemma4:31b

# --- Robinhood market data (robin_stocks) ---
# Credentials for the account used ONLY to read market data. On first run robin_stocks
# will prompt for an MFA code interactively unless robinhood_token_path already has a
# cached session.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOKEN_PATH=.secrets/robinhood_token.pickle

# --- Robinhood Trading MCP (account state + order execution, isolated Agentic account) ---
MCP_SERVER_URL=https://agent.robinhood.com/mcp/trading
MCP_TOKEN_STORE_PATH=.secrets/mcp_token.json
# Populated by ONE of:
#   `uv run scripts/bootstrap_mcp_oauth.py` (standalone script, opens its own local
#     server + browser), or
#   GET /oauth/robinhood/authorize on the running app (see api/robinhood_oauth.py) --
#     convenient when there's no easy way to run a local script against wherever
#     this is deployed.
# Use one or the other, not both, against the same MCP_OAUTH_REDIRECT_URI at once.
# Must be a publicly reachable URL for the /oauth/robinhood/authorize path in
# production, since Robinhood redirects the browser here directly.
MCP_OAUTH_REDIRECT_URI=http://localhost:8765/callback
# The Agentic account's account_number (NOT your main brokerage account) -- every
# position/order MCP tool requires this explicitly, it's never auto-selected.
# scripts/bootstrap_mcp_oauth.py prints your accounts (with agentic_allowed) at the
# end of the OAuth flow -- use the one with agentic_allowed=true. Unset is fine in
# MODE=DRY_RUN; GET /broker/positions/<ticker> fails fast with a clear error if
# you're missing this and try to use it.
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=

# --- Schwab market data (schwab-py, primary quote/5-min-historicals source) ---
# Falls back to the Robinhood market data above on any failure -- see
# market_data/market_data_client.py and requirements.md Phase 4. Get a client
# ID/secret by registering an app at https://developer.schwab.com. One-time
# browser consent via `uv run scripts/bootstrap_schwab_oauth.py`, which must use
# a callback URL exactly matching SCHWAB_CALLBACK_URL below (Schwab requires
# HTTPS here). Schwab refresh tokens expire after ~7 days of being unused for
# login (schwab-py proactively invalidates anything older) -- re-run the
# bootstrap script periodically; the Robinhood fallback covers any gap
# automatically in the meantime.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=.secrets/schwab_token.json

# --- Strategy / watchlist ---
WATCHLIST=AAPL,TSLA,NVDA
CONFIDENCE_THRESHOLD=0.7
# Broad-market benchmark shown to the LLM alongside each ticker's own bucket history
# (today's change %, VWAP deviation, and high-low range as a volatility proxy) --
# lets it weigh a ticker-specific setup against whether the whole market is trending
# with it or against it. Set to empty to disable the extra fetch entirely.
MARKET_BENCHMARK_TICKER=SPY
# RSI lookback period (bars), Wilder-smoothed, computed from 5-min closes. Reads
# null intraday until this many bars have accumulated (70 min at the default 14).
RSI_PERIOD=14

# --- Guardrails ---
MAX_OPEN_POSITIONS_PER_TICKER=1
DAILY_TRADE_CAP_PER_TICKER=3
MAX_CAPITAL_PER_TRADE_USD=500
MAX_DAILY_DRAWDOWN_USD=1000
ORDER_TIMEOUT_MINUTES=15

# --- Schedule (America/New_York) ---
TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30
EVALUATION_WINDOW_END_TIME=11:30
EOD_LIQUIDATION_TIME=15:45
POLL_INTERVAL_MINUTES=5

# --- Alerts ---
WEBHOOK_URL=

# --- Stateful decision engine (Phase 3) ---
# Per-ticker working evaluation state (status/active thesis/decision log) across
# poll cycles -- ephemeral, Postgres stays the durable audit trail. Point at any
# Redis-compatible host later by changing only this value.
REDIS_URL=redis://localhost:6379/0
DECISION_HISTORY_LENGTH=5
TICKER_STATE_TTL_HOURS=24
# When true, a favorable stop/target ratchet cancels and replaces the resting sell
# order at the new price. The stop-loss/momentum forced-exit check itself always
# runs regardless of this flag.
TRAILING_STOP_ENABLED=true
